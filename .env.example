# Job Finder — Google Programmable Search Engine (Custom Search JSON API)
# Copy this file to ".env" and fill in real values. Never commit ".env".
#
# 1. Create a Programmable Search Engine at https://programmablesearchengine.google.com/
#    - Set it to search onlinejobs.ph (or "search the entire web" — the
#      backend already restricts every query with site:onlinejobs.ph).
#    - Copy its "Search engine ID" -> GOOGLE_SEARCH_CLIENT_ID (this is the
#      API's "cx" parameter).
# 2. Enable the "Custom Search API" in Google Cloud Console and create an
#    API key -> GOOGLE_SEARCH_API_KEY.
#
# Without both values set, Job Finder will show "Google search integration
# is not configured yet." and will not attempt any request.

GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CLIENT_ID=

BRAVE_SEARCH_API_KEY=BSAemyk2oeIYmEznAAINW-Mc0G9p0XM

# Automation Engine — shared secret required in the X-Automation-Key header
# on POST /api/automations/execute. Without this set, that endpoint refuses
# every request (fails closed). Generate a long random value yourself;
# never commit the real value, never log it, never return it from any API.
AUTOMATION_API_KEY=

# n8n "Appointment Reminder" workflow webhook (its Webhook Trigger node's URL,
# path "crm-appointment"). When a contact is created/updated with a
# bookingDate or bookingTime, the CRM fires a non-blocking POST here.
# Without this set, the CRM simply skips the notification (contact saves
# still succeed) and logs a short warning — it never fails the save.
N8N_APPOINTMENT_WEBHOOK_URL=